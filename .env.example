# ==========================================
# Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values
# WARNING: Never commit the actual .env file to git!

# ==========================================
# AI Model Configuration
# ==========================================
# Set to 'true' for OpenAI or 'false' for Gemini
OPENAI_GEMINI_MODE=false

# OpenAI API Key (Required ONLY if OPENAI_GEMINI_MODE=true)
# Get your key from: https://platform.openai.com/api-keys
# Uses gpt-4o-mini model
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini API Key (Required ONLY if OPENAI_GEMINI_MODE=false)
# Get your FREE key from: https://aistudio.google.com/app/apikey
# Uses gemini-2.0-flash-exp model
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/todo_dev

# ==========================================
# JWT Authentication Secret
# ==========================================
# Generate a secure random string for production
# Example: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Database Configuration (Docker Compose)
# ==========================================
# These are defaults from docker-compose.yml
# Uncomment and change only if you need different values
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=todo_dev
